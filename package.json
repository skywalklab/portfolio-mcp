{
	"name": "portfolio",
	"version": "1.0.0",
	"description": "MCP server exposing portfolio projects, experience, and skills data",
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"dev": "concurrently \"tsc --watch\" \"nodemon build/index.js\"",
		"build": "tsc && copyfiles -u 2 'src/lib/experience/*.pdf' 'src/lib/experience/*.csv' build/lib && chmod 755 build/index.js",
		"start": "node build/index.js"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.5.0",
		"concurrently": "^9.2.1",
		"copyfiles": "^2.4.1",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.1",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@opendocsg/pdf2md": "^0.2.6",
		"cors": "^2.8.6",
		"csv-parse": "^6.2.1",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"zod": "^4.4.2"
	}
}
